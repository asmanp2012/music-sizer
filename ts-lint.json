{
  "compilerOptions": {
    "incremental": true,
    "target": "ESNEXT",
    "module": "ESNEXT",                      
    "lib": [ "ESNEXT", "DOM", "DOM.Iterable" ],
    "declaration": true,
    "composite": true,
    "importHelpers": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  "include": [ 
    "package/**/*.ts",
    "demo/**/*.ts"
  ],
  "exclude": [],
  "compileOnSave": false
}
