{
  "name": "@music-sizer/lib",
  "description": "Typeserver library.",
  "version": "0.0.1",
  "main": "./index.js",
  "type": "module",
  "private": true,
  "workspaces": [
    "package/*",
    "demo"
  ],
  "scripts": {
    "b": "bun run build",
    "w": "bun run watch",
    "s": "bun run serve",
    "c": "bun run clean",
    "cb": "bun run clean-build",
    "sing": "py ./package/singer/0_analyze_vocal.py",
    "fast_sing": "py ./package/singer/0_fast_sing.py",
    "sing_grouping": "py ./package/singer/1_grouping_freq.py",
    "sing_analyze": "py ./package/singer/2_analyze_bpm.py",
    "sing_speed": "py ./package/singer/3_chose_bpm.py",
    "sing_signature": "py ./package/singer/4_detect_time_signature.py",
    "p": "bun run prepare-publish && bun run ver && bun run release",
    "pp": "bun run prepare-publish && bun run ver-patch && bun run release",
    "up": "bun run upgrade-interactive --latest && git status && bash -c 'read -p \"Continue ?\" -n 1'",
    "build": "bun run lint && bun run build:ts",
    "build:ts": "tsc --build",
    "lint": "eslint .",
    "prepare": "bun run build",
    "serve": "node ./demo/index.js",
    "watch": "bun run lint && bun run watch:ts && bun run watch:serve",
    "watch:ts": "bun run build:ts",
    "watch:serve": "node ./demo/index.js",
    "clean": "tsc --build --clean",
    "clean-build": "bun run clean && bun run build"
  },
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-wc": "^3.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  },
  "author": "Godgiven",
  "license": "Apache-2.0"
}
