{
  "name": "@music-sizer/lib",
  "description": "Typeserver library.",
  "version": "0.0.1",
  "main": "./index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "package/*"
  ],
  "scripts": {
    "w": "bun run watch",
    "s": "bun run serve",
    "c": "bun run clean",
    "lint": "eslint .",
    "rep": "bun ./package/singer/index.ts",
    "serve": "bun ./package/demo/index.ts",
    "watch": "bun run lint && bun run serve",
    "clean": "rm demo/**/*.mid demo/**/*.mid.json"
  },
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-wc": "^3.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  },
  "author": "Godgiven",
  "license": "Apache-2.0"
}
